# 把本文件放到你 Fork 后的仓库的  .github/workflows/build-bt-rb300-512m.yml
# 然后到仓库 Actions 页手动 Run workflow（或 push 到 openwrt-24.10-6.6 分支即可自动触发）

name: Build ImmortalWrt (BT-RB300 / 512MB)

on:
  workflow_dispatch:
  push:
    branches: [openwrt-24.10-6.6]
    paths:
      - '.github/workflows/build-bt-rb300-512m.yml'

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          sudo docker image prune --all --force
          sudo apt-get clean
          df -h

      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 1
          ref: openwrt-24.10-6.6

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y ack antlr3 asciidoc autoconf automake autopoint binutils bison build-essential \
            bzip2 ccache clang cmake cpio curl device-tree-compiler ecj fastjar flex gawk gettext gcc-multilib \
            g++-multilib git gnutls-dev gperf haveged help2man intltool libc6-dev-i386 libelf-dev libglib2.0-dev \
            libgmp3-dev libltdl-dev libmpc-dev libmpfr-dev libncurses-dev libpython3-dev libreadline-dev libssl-dev \
            libtool libyaml-dev libz-dev lld llvm lrzsz mkisofs msmtp nano ninja-build p7zip p7zip-full patch \
            pkgconf python3 python3-pip python3-ply python3-docutils python3-pyelftools qemu-utils re2c rsync \
            scons squashfs-tools subversion swig texinfo uglifyjs upx-ucl unzip vim wget xmlto xxd zlib1g-dev zstd

      # 关键：把 DTS 内存节点从 256MB (0x10000000) 改成 512MB (0x20000000)
      - name: Patch DTS for 512MB RAM
        run: |
          DTS=target/linux/mediatek/dts/mt7981b-bt-rb300.dts
          echo "== before ==" && grep -n "0x10000000\|0x20000000" $DTS
          sed -i 's/<0 0x40000000 0 0x10000000>/<0 0x40000000 0 0x20000000>/' $DTS
          echo "== after  ==" && grep -n "0x10000000\|0x20000000" $DTS

      - name: Update & install feeds
        run: |
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      # 只编译 bt-rb300，去掉 defconfig 里其他 ~25 个设备，大幅缩短时间
      - name: Configure (BT-RB300 only)
        run: |
          cp defconfig/mt7981-ax3000.config .config
          sed -i '/CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_/d' .config
          echo 'CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_bt_rb300=y' >> .config
          echo 'CONFIG_AUTOREMOVE=y' >> .config
          # 用主线 mt76/mt7915e 驱动替代私有 mtk_wifi 闭源驱动，
          # 避免 warp_proxy 找不到 warp_wifi.h 导致编译失败。
          # BT-RB300 的设备包本来就是 kmod-mt7915e（主线），去掉闭源驱动不影响 WiFi。
          sed -i '/CONFIG_PACKAGE_kmod-mt_wifi/d' .config
          sed -i '/CONFIG_PACKAGE_kmod-warp/d' .config
          sed -i '/CONFIG_PACKAGE_luci-app-mtwifi-cfg/d' .config
          sed -i '/CONFIG_PACKAGE_luci-app-eqos-mtk/d' .config
          sed -i '/CONFIG_PACKAGE_luci-app-turboacc-mtk/d' .config
          make defconfig
          ./scripts/diffconfig.sh

      - name: Verify BT-RB300 is enabled
        run: |
          grep -q 'CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_bt_rb300=y' .config \
            || { echo "!! bt-rb300 NOT enabled, abort"; exit 1; }
          # 确认已切到主线驱动：闭源 mt_wifi 不应存在，主线 mt7915e 应存在
          if grep -q 'CONFIG_PACKAGE_kmod-mt_wifi=y' .config; then
            echo "!! kmod-mt_wifi still selected, abort"; exit 1
          fi
          grep -q 'CONFIG_PACKAGE_kmod-mt7915e=y' .config \
            || { echo "!! kmod-mt7915e (mainline) missing, abort"; exit 1; }

      - name: Build
        run: |
          make -j$(nproc) || make -j1 V=s

      - name: Upload firmware
        uses: actions/upload-artifact@v4
        with:
          name: immortalwrt-bt-rb300-512mb
          path: bin/targets/mediatek/filogic/*
